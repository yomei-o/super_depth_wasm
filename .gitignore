# The Ghidra PROJECT is machine-local and big; the decompilation output itself is
# committed (decomp/) so the analysis can be continued on a machine without
# Ghidra installed.  Regenerate either with the command in RESUME.md.
/ghidra_proj/

# Scratch: PNG dumps and disassembly snippets while poking at the binary.
/tmp/

# Build output.
/tests/*.exe
/depth.exe
*.o

# Python bytecode from tools/.
__pycache__/
